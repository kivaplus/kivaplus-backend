# Development Dockerfile for running the Go application
# This is optional - you can also run Go directly on your host

FROM golang:1.24-alpine AS development

# Install necessary packages
RUN apk add --no-cache git postgresql-client curl jq

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Install development tools (simplified for testing)
# RUN go install github.com/air-verse/air@latest
# RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@latest

# Expose port
EXPOSE 8080

# Default command (can be overridden)
CMD ["go", "run", "cmd/local-server/main.go"]
