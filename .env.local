# Local Development Environment Configuration
# Copy this to .env and adjust values for your local setup

# Database Configuration (Docker PostgreSQL)
DATABASE_URL=postgres://kivaplus:kivaplus123@localhost:5432/kivaplus_local?sslmode=disable

# Redis Configuration (Docker Redis)
REDIS_URL=redis://:kivaplus123@localhost:6379

# JWT Configuration
JWT_SECRET=local-development-secret-key-not-for-production
JWT_SECRET_NAME=kivaplus/jwt-secret

# Server Configuration
PORT=8080

# Logging
LOG_LEVEL=debug

# AWS Configuration (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack Configuration
LOCALSTACK_ENDPOINT=http://localhost:4566
USE_LOCALSTACK=true

# Performance Optimization Settings
CACHE_TTL=900
TOKEN_VERSION_TTL=86400
USE_ENHANCED_PERMISSIONS=true

# Integration Test Configuration
API_GATEWAY_URL=http://localhost:4566/restapis/test-api/local/_user_request_
TEST_TIMEOUT=30s

# Note: For local development with Docker:
# - DATABASE_URL connects to PostgreSQL container
# - REDIS_URL connects to Redis container
# - AWS services use LocalStack (USE_LOCALSTACK=true)
# - Enhanced permissions system is enabled
# - All services run in Docker containers for consistency
